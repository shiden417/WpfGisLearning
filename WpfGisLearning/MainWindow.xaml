<Window x:Class="WpfGisLearning.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfGisLearning"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF7F5F2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFB4552B" />
        <SolidColorBrush x:Key="CardBackground" Color="White" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="#FFE6E6E6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="BorderBrush" Value="#FFECECEC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="🍜 Ramenia" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" ToolTip="検索">🔍</Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="設定">⚙</Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="12" VerticalAlignment="Stretch">
                <Border Style="{StaticResource Card}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="🏠 店舗" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                        <TextBlock Text="★ お気に入り" FontSize="14" Margin="0,0,0,8" />
                        <TextBlock Text="＋ 店舗追加" FontSize="14" Margin="0,0,0,8" />
                        <TextBlock Text="⚙ 設定" FontSize="14" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Column="1" Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <ContentControl x:Name="MainContent" />
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid>
                        <mapsui:MapControl x:Name="MapControl" />

                        <!-- 選択中店舗の詳細情報カード -->
                        <Border x:Name="InfoCardBorder"
                                Background="White"
                                CornerRadius="10"
                                Padding="12"
                                Width="280"
                                MaxHeight="220"
                                Visibility="Collapsed"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="12"
                                BorderBrush="#FFE0E0E0"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           x:Name="InfoCardName"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#FF2F2F2F"
                                           Text="店舗名" />

                                <Button Grid.Row="0"
                                        Grid.Column="2"
                                        Content="×"
                                        Width="28"
                                        Height="28"
                                        Margin="0"
                                        VerticalAlignment="Top"
                                        Click="InfoCardClose_Click" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="住所"
                                           FontSize="11"
                                           Foreground="#FF888888"
                                           Margin="0,10,10,0" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="2"
                                           x:Name="InfoCardAddress"
                                           FontSize="12"
                                           Text="住所"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="価格"
                                           FontSize="11"
                                           Foreground="#FF888888"
                                           Margin="0,6,10,0" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="2"
                                           x:Name="InfoCardPrice"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FFB4552B"
                                           Text="-"
                                           Margin="0,6,0,0" />

                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Text="緯度"
                                           FontSize="11"
                                           Foreground="#FF888888"
                                           Margin="0,6,10,0" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="2"
                                           x:Name="InfoCardLatitude"
                                           FontSize="11"
                                           Text="-"
                                           Margin="0,6,0,0" />

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Text="経度"
                                           FontSize="11"
                                           Foreground="#FF888888"
                                           Margin="0,6,10,0" />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="2"
                                           x:Name="InfoCardLongitude"
                                           FontSize="11"
                                           Text="-"
                                           Margin="0,6,0,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>

</Window>