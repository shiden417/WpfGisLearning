<Window x:Class="WpfGisLearning.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ramenia" Width="1500" Height="900" MinWidth="900" MinHeight="700" Background="{StaticResource WindowBackgroundBrush}">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}">
            <Grid Margin="24,0">
                <StackPanel VerticalAlignment="Center"><TextBlock Text="🍜 Ramenia" Foreground="{StaticResource SurfaceBrush}" FontSize="28" FontWeight="Bold" /></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="🗺" Click="ShopMapButton_Click" Style="{StaticResource HeaderIconButton}" ToolTip="店舗・地図" /><Button Content="📰" Click="NewsButton_Click" Style="{StaticResource HeaderIconButton}" ToolTip="ラーメンニュース" /></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid x:Name="MainArea" Margin="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="480" MinWidth="340" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" MinWidth="300" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource WindowBackgroundBrush}" CornerRadius="0" BorderBrush="Transparent" BorderThickness="0" ClipToBounds="True"><ContentControl x:Name="MainContent" /></Border>
                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" />
                <ContentControl Grid.Column="2" x:Name="MapContent" />
            </Grid>
            <ContentControl x:Name="NewsContent" Margin="14,14,0,14" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
