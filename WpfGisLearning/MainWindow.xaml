<Window x:Class="WpfGisLearning.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        Title="Ramenia" Width="1500" Height="900" MinWidth="900" MinHeight="700" Background="{StaticResource WindowBackgroundBrush}">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}">
            <Grid Margin="24,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🍜 Ramenia" Foreground="{StaticResource SurfaceBrush}" FontSize="28" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="⇩" Click="DownloadExcelTemplateButton_Click" Style="{StaticResource HeaderIconButton}" ToolTip="Excel入力テンプレートをダウンロード" />
                    <Button Content="↥" Click="ExportExcelButton_Click" Style="{StaticResource HeaderIconButton}" ToolTip="店舗データをExcelに書き出す" />
                    <Button Content="↧" Click="ImportExcelButton_Click" Style="{StaticResource HeaderIconButton}" ToolTip="Excelから店舗データを読み込む" />
                    <Button Content="🗺" Click="ShopMapButton_Click" Style="{StaticResource HeaderIconButton}" ToolTip="店舗・地図" />
                    <Button Content="📰" Click="NewsButton_Click" Style="{StaticResource HeaderIconButton}" ToolTip="ラーメンニュース" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid x:Name="MainArea" Margin="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="480" MinWidth="340" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" MinWidth="300" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True"><ContentControl x:Name="MainContent" /></Border>
                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" />
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <mapsui:MapControl x:Name="MapControl" />
                        <TextBlock x:Name="MapStatusText" Text="" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ErrorBrush}" Background="#EEFFFFFF" Padding="14,10" FontSize="13" TextWrapping="Wrap" MaxWidth="360" Visibility="Collapsed" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Background="#F8FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4" Panel.ZIndex="100">
                            <StackPanel>
                                <Button Content="＋  全店舗" Click="ShowAllShopsButton_Click" Padding="10,6" FontWeight="SemiBold" Margin="1" />
                                <Button Content="◎  現在地" Click="CurrentLocationButton_Click" Padding="10,6" FontWeight="SemiBold" Margin="1" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                                    <Button Content="＋" Click="ZoomInButton_Click" Style="{StaticResource MapControlButton}" ToolTip="拡大" />
                                    <Button Content="−" Click="ZoomOutButton_Click" Style="{StaticResource MapControlButton}" ToolTip="縮小" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="InfoCardBorder" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="16" Width="330" Visibility="Collapsed" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" RenderTransformOrigin="1,1">
                            <Border.RenderTransform><TranslateTransform X="18" Y="18" /></Border.RenderTransform>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Text="店舗情報" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                <Button Grid.Row="0" Grid.Column="1" Content="×" Width="28" Height="28" Margin="0" Padding="0" Click="InfoCardClose_Click" />
                                <TextBlock Grid.Row="1" x:Name="InfoCardName" Text="店舗名" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                    <TextBlock x:Name="InfoCardType" Text="種類" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="InfoCardAddress" Text="住所" FontSize="13" Foreground="{StaticResource LabelBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <TextBlock x:Name="InfoCardPrice" Text="-" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
                                    <TextBlock x:Name="InfoCardRating" Text="" FontSize="12" Foreground="{StaticResource RatingBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <ContentControl x:Name="NewsContent" Margin="14,14,0,14" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
