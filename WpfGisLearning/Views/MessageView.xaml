<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="WpfGisLearning.Views.MessageView">
	<Border
        Padding="20"
        Margin="10"
        BorderThickness="1">

		<StackPanel>
			<TextBlock
	Text="{Binding Message}"
	FontSize="24" />

			<Button Content="変更"
					Command="{Binding ChangeMessageCommand}"
					Margin="0,10,0,0">
			</Button>

			<Button Content="Shopサンプル"
				Command="{Binding DataContext.UseShopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				Margin="0,6,0,0" />

			<Button Content="async処理テスト"
				Command="{Binding RunAsyncTestCommand}"
				Margin="0,6,0,0"
				Style="{StaticResource PrimaryButton}" />

			<Button Content="店舗一覧"
				Command="{Binding DataContext.ShowShopListCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				Margin="0,6,0,0" />

			<Button Content="Frameページサンプル"
				Command="{Binding DataContext.NavigateToShopPageFrameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				Margin="0,6,0,0" />
		</StackPanel>
	</Border>

</UserControl>