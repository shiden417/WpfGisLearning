<UserControl x:Class="WpfGisLearning.Views.ShopListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WpfGisLearning.Models">
    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ShopCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderBrush" Value="#FFE9DED8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#FFF9F4EF" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8,8,8,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="店舗を探す" FontSize="24" FontWeight="Bold" Foreground="#FF332925" />
                <TextBlock Text="名前や住所からラーメン店を検索できます" FontSize="12" Foreground="#FF8A7568" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="＋ 店舗を登録" Command="{Binding NewShopCommand}" Background="#FFB83D2E" Foreground="White" BorderThickness="0" Padding="16,10" FontWeight="Bold" />
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="12" Margin="8,0,8,14" BorderBrush="#FFE9DED8" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="4,0,8,0" />
                    <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Padding="30,6,8,6"
                             BorderThickness="0"
                             Background="#FFF7F2EE"
                             VerticalContentAlignment="Center" />
                </Grid>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                          Height="36"
                          Margin="10,0,0,0"
                          Padding="8,4" />

                <Button Grid.Column="2"
                        Content="クリア"
                        Command="{Binding ClearSearchCommand}"
                        Padding="10,7"
                        Margin="8,0,0,0" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,0">
            <ListBox ItemsSource="{Binding ShopsView}"
                     SelectedItem="{Binding SelectedShop, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Shop}">
                        <Border Style="{StaticResource ShopCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#FF332925" />
                                    <TextBlock Text="{Binding Address, TargetNullValue=住所未登録}" FontSize="12" Foreground="#FF7D6B63" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Price, StringFormat=¥{0:N0}}" FontSize="15" FontWeight="Bold" Foreground="#FFB83D2E" Margin="0,8,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="🍜" FontSize="24" VerticalAlignment="Center" Margin="12,0,4,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <Border Grid.Row="3" Background="White" BorderBrush="#FFE9DED8" BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ActionButton}" Content="詳細を見る" Command="{Binding OpenSelectedShopCommand}" />
                <Button Style="{StaticResource ActionButton}" Content="編集" Command="{Binding EditSelectedShopCommand}" Background="#FFF28C28" Foreground="White" BorderThickness="0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
