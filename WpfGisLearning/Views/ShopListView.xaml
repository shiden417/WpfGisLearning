<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:WpfGisLearning.ViewModels"
    xmlns:models="clr-namespace:WpfGisLearning.Models"
    x:Class="WpfGisLearning.Views.ShopListView">

    <UserControl.Resources>

        <!-- ========================= -->
        <!-- 店舗カード -->
        <!-- ========================= -->

        <Style x:Key="ShopCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White" />

            <Setter Property="CornerRadius"
                    Value="12" />

            <Setter Property="Padding"
                    Value="16" />

            <Setter Property="Margin"
                    Value="0" />

            <Setter Property="BorderBrush"
                    Value="#FFE5E0DC" />

            <Setter Property="BorderThickness"
                    Value="1" />

        </Style>


        <!-- ========================= -->
        <!-- ListBox本体 -->
        <!-- ========================= -->

        <Style TargetType="ListBox">

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="Padding"
                    Value="0" />

            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled" />

        </Style>


        <!-- ========================= -->
        <!-- ListBox項目 -->
        <!-- ========================= -->

        <Style TargetType="ListBoxItem">

            <Setter Property="Background"
            Value="Transparent" />

            <Setter Property="BorderThickness"
            Value="0" />

            <Setter Property="Padding"
            Value="0" />

            <Setter Property="Margin"
            Value="0,0,0,10" />

            <Setter Property="HorizontalContentAlignment"
            Value="Stretch" />

            <Setter Property="FocusVisualStyle"
            Value="{x:Null}" />

            <EventSetter
        Event="PreviewMouseDoubleClick"
        Handler="ShopListItem_PreviewMouseDoubleClick" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ListBoxItem">

                        <Border
                    x:Name="ItemBorder"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="12">

                            <ContentPresenter />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected"
                             Value="True">

                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="#FFFFF7F2" />

                                <Setter TargetName="ItemBorder"
                                Property="BorderBrush"
                                Value="#FFB4552B" />

                                <Setter TargetName="ItemBorder"
                                Property="BorderThickness"
                                Value="2" />

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="#FFFAF8F6" />

                            </Trigger>

                            <MultiTrigger>

                                <MultiTrigger.Conditions>

                                    <Condition Property="IsSelected"
                                       Value="True" />

                                    <Condition Property="IsMouseOver"
                                       Value="True" />

                                </MultiTrigger.Conditions>

                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="#FFFFF7F2" />

                            </MultiTrigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>
    </UserControl.Resources>


    <Grid Margin="8">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>


        <!-- ========================= -->
        <!-- 新規店舗登録 -->
        <!-- ========================= -->

        <Border
            Grid.Row="0"
            Background="White"
            CornerRadius="12"
            Padding="14"
            Margin="0,0,0,12"
            BorderBrush="#FFE5E0DC"
            BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="120" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>


                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,12,0">

                    <TextBlock
                        Text="店舗名"
                        FontSize="12"
                        Foreground="#FF777777"
                        Margin="0,0,0,4" />

                    <TextBox
                        Height="32"
                        Text="{Binding NewShopName,
                                       UpdateSourceTrigger=PropertyChanged,
                                       ValidatesOnNotifyDataErrors=True,
                                       NotifyOnValidationError=True}"
                        ToolTip="{Binding (Validation.Errors)[0].ErrorContent,
                                          RelativeSource={RelativeSource Self}}" />

                </StackPanel>


                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,12,0">

                    <TextBlock
                        Text="価格"
                        FontSize="12"
                        Foreground="#FF777777"
                        Margin="0,0,0,4" />

                    <TextBox
                        Height="32"
                        Text="{Binding NewShopPrice,
                                       UpdateSourceTrigger=PropertyChanged,
                                       ValidatesOnNotifyDataErrors=True,
                                       NotifyOnValidationError=True}"
                        ToolTip="{Binding (Validation.Errors)[0].ErrorContent,
                                          RelativeSource={RelativeSource Self}}" />

                </StackPanel>


                <Button
                    Grid.Column="2"
                    Content="＋ 登録"
                    Command="{Binding RegisterCommand}"
                    VerticalAlignment="Bottom"
                    Padding="16,6"
                    Height="32" />

            </Grid>

        </Border>


        <!-- ========================= -->
        <!-- 店舗一覧 -->
        <!-- ========================= -->

        <ListBox
            Grid.Row="1"
            ItemsSource="{Binding ShopsView}"
            SelectedItem="{Binding SelectedShop, Mode=TwoWay}">

            <ListBox.ItemTemplate>

                <DataTemplate
                    DataType="{x:Type models:Shop}">

                    <Border
    Style="{StaticResource ShopCardStyle}">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>


                            <!-- 店舗情報 -->

                            <StackPanel
                                Grid.Column="0">

                                <TextBlock
                                    Text="{Binding Name}"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Foreground="#FF2F2F2F" />


                                <TextBlock
                                    Text="{Binding Address}"
                                    FontSize="12"
                                    Foreground="#FF777777"
                                    Margin="0,5,0,0"
                                    TextWrapping="Wrap" />


                                <TextBlock
                                    Text="{Binding Price,
                                                   StringFormat=¥{0:N0}}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#FFB4552B"
                                    Margin="0,8,0,0" />

                            </StackPanel>


                            <!-- 店舗ID -->

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Id,
                                               StringFormat=No.{0}}"
                                FontSize="11"
                                Foreground="#FF999999"
                                VerticalAlignment="Top"
                                Margin="12,0,0,0" />

                        </Grid>

                    </Border>

                </DataTemplate>

            </ListBox.ItemTemplate>

        </ListBox>


        <!-- ========================= -->
        <!-- 並び替え -->
        <!-- ========================= -->

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,10,0,0">

            <Button
                Content="価格:安い順"
                Command="{Binding SortPriceAscCommand}"
                Margin="0,0,6,0"
                Padding="10,5" />

            <Button
                Content="価格:高い順"
                Command="{Binding SortPriceDescCommand}"
                Margin="0,0,6,0"
                Padding="10,5" />

            <Button
                Content="詳細"
                Command="{Binding OpenSelectedShopCommand}"
                Padding="10,5" />

        </StackPanel>

    </Grid>

</UserControl>