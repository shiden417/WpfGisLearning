<Window x:Class="WpfGisLearning.Views.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="確認" Height="150" Width="300" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="この店舗を削除しますか?" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="はい" Width="80" Margin="0,0,8,0" Click="Yes_Click" IsDefault="True" />
            <Button Content="いいえ" Width="80" Click="No_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
