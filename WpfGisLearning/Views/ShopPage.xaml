<Page
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="WpfGisLearning.Views.ShopPage"
  Title="ShopPage">
    <StackPanel Margin="16">
        <TextBlock Text="Shop Page (Frame sample)" FontSize="18" FontWeight="Bold" />
        <TextBlock Text="サンプル: DetailPage を開く" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Open Detail (ID=1)" Click="OpenDetail1_Click" Margin="0,0,8,0" />
            <Button Content="Open Detail (ID=2)" Click="OpenDetail2_Click" />
        </StackPanel>
    </StackPanel>
</Page>
