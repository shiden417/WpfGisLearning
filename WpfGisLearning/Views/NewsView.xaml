<UserControl x:Class="WpfGisLearning.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="Button"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#FF343A40" /><Setter Property="BorderBrush" Value="#FFE0DBD4" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="12,7" /><Setter Property="Margin" Value="3" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /></Style>
        <Style x:Key="NewsCard" TargetType="Border"><Setter Property="Cursor" Value="Hand" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#FFC56B4D" /><Setter Property="Background" Value="#FFFFFCFA" /></Trigger></Style.Triggers></Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FFF4F1EC">
        <StackPanel Margin="28">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="📰 ラーメンニュース" FontSize="28" FontWeight="Bold" Foreground="#FF252A2F" />
                    <TextBlock Text="日付を指定してラーメン関連ニュースを取得" Foreground="#FF747D84" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="↻ 更新" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Padding="14,9" />
            </DockPanel>
            <DockPanel Margin="0,18,0,0">
                <TextBlock Text="日付" FontWeight="SemiBold" Foreground="#FF343A40" VerticalAlignment="Center" />
                <DatePicker SelectedDate="{Binding SelectedDate}" Width="150" Margin="12,0,0,0" Padding="8,3" />
                <Button Content="検索" Command="{Binding RefreshCommand}" Padding="14,7" />
                <TextBlock Text="カテゴリ" FontWeight="SemiBold" Foreground="#FF343A40" VerticalAlignment="Center" Margin="18,0,0,0" />
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Width="150" Margin="12,0,0,0" Padding="8,0" />
                <TextBlock Text="{Binding StatusMessage}" DockPanel.Dock="Right" Foreground="#FF9A938C" VerticalAlignment="Center" Margin="12,0,0,0" />
            </DockPanel>
            <Border Background="#FFF8F5F1" CornerRadius="10" Padding="10" Margin="0,12,0,0">
                <TextBlock Text="ニュース一覧の項目をダブルクリックすると、元の記事をブラウザで開きます。" FontSize="11" Foreground="#FF747D84" />
            </Border>
            <TextBlock Text="注目の記事" FontSize="20" FontWeight="Bold" Foreground="#FF252A2F" Margin="0,18,0,10" />
            <ItemsControl ItemsSource="{Binding FeaturedNews}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="14" BorderBrush="#FFE0DBD4" BorderThickness="1" Margin="0,0,8,0" Padding="16" Style="{StaticResource NewsCard}" MouseLeftButtonDown="NewsCard_MouseLeftButtonDown">
                            <StackPanel>
                                <Border Height="110" Background="#FFE8CFC3" CornerRadius="10"><TextBlock Text="🍜" FontSize="52" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <TextBlock Text="{Binding Category}" Foreground="#FFC56B4D" FontSize="11" FontWeight="Bold" Margin="0,12,0,4" />
                                <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" Foreground="#FF252A2F" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#FF747D84" TextWrapping="Wrap" Margin="0,7,0,0" />
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PublishedAt, StringFormat=yyyy.MM.dd}" Grid.Column="0" FontSize="11" Foreground="#FF9A938C" /><TextBlock Text="{Binding SourceName}" Grid.Column="2" FontSize="11" Foreground="#FF9A938C" /></Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,28,0,10"><TextBlock Text="新着ニュース" FontSize="20" FontWeight="Bold" Foreground="#FF252A2F" /><TextBlock DockPanel.Dock="Right" Text="指定日・最新順" Foreground="#FF9A938C" VerticalAlignment="Bottom" /></DockPanel>
            <ItemsControl ItemsSource="{Binding NewsView}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="12" BorderBrush="#FFE0DBD4" BorderThickness="1" Padding="14" Margin="0,0,0,8" Style="{StaticResource NewsCard}" MouseLeftButtonDown="NewsCard_MouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="76" Background="#FFF3E1DA" CornerRadius="8"><TextBlock Text="🍜" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="{Binding Category}" Foreground="#FFC56B4D" FontSize="11" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="#FF252A2F" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#FF747D84" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PublishedAt, StringFormat=yyyy.MM.dd HH:mm}" Grid.Column="0" FontSize="10" Foreground="#FF9A938C" /><TextBlock Text="{Binding Region}" Grid.Column="2" FontSize="10" Foreground="#FF9A938C" /></Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>