<UserControl x:Class="WpfGisLearning.Views.NewsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="Button"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#FF343A40" /><Setter Property="BorderBrush" Value="#FFE0DBD4" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="12,7" /><Setter Property="Margin" Value="3" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FFF3E1DA" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFC56B4D" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FFE8CFC3" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="RefreshButton" TargetType="Button"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#FF747D84" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="4,0,0,0" /><Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="FontSize" Value="18" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FFF3E1DA" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FFE8CFC3" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="LoadingBar" TargetType="ProgressBar"><Setter Property="Height" Value="4" /><Setter Property="Visibility" Value="Collapsed" /><Setter Property="Foreground" Value="#FFC56B4D" /><Setter Property="Background" Value="#FFE8CFC3" /><Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="LoadingIndicator" TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NewsCard" TargetType="Border"><Setter Property="Cursor" Value="Hand" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#FFC56B4D" /><Setter Property="Background" Value="#FFFFFCFA" /></Trigger></Style.Triggers></Style>
        <Style x:Key="ImagePlaceholder" TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasImage}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NewsImage" TargetType="Image"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasImage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FFF4F1EC">
        <StackPanel Margin="14,14,14,28">
            <Grid Margin="0,0,0,18"><TextBlock Text="📰 ラーメンニュース" FontSize="28" FontWeight="Bold" Foreground="#FF252A2F" /></Grid>
            <Border Background="White" BorderBrush="#FFE0DBD4" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="日付" FontWeight="SemiBold" Foreground="#FF343A40" /><TextBlock Text="取得する日を選択" FontSize="10" Foreground="#FF9A938C" Margin="0,2,0,0" /></StackPanel><DatePicker Grid.Column="1" SelectedDate="{Binding SelectedDate}" Margin="16,0,0,0" Padding="8,4" /><Button Grid.Column="3" Content="↻" ToolTip="ニュースを更新" Command="{Binding RefreshCommand}" Style="{StaticResource RefreshButton}" VerticalAlignment="Center" /></Grid></Border>
            <ProgressBar Style="{StaticResource LoadingBar}" IsIndeterminate="True" Margin="4,6,4,0" />
            <Border Background="#FFF8F5F1" CornerRadius="10" Padding="12" Margin="0,8,0,0" Style="{StaticResource LoadingIndicator}"><StackPanel Orientation="Horizontal"><TextBlock Text="◌" FontSize="16" Foreground="#FFC56B4D" Margin="0,0,8,0" /><TextBlock Text="ニュースを読み込んでいます…" FontSize="12" FontWeight="SemiBold" Foreground="#FF59636D" VerticalAlignment="Center" /></StackPanel></Border>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#FF9A938C" FontSize="11" Margin="4,8,0,0" />
            <Border Background="#FFF8F5F1" CornerRadius="10" Padding="10" Margin="0,8,0,0"><TextBlock Text="ニュース一覧をダブルクリックすると、元の記事をブラウザで開きます。画像がない記事はラーメンアイコンを表示します。" FontSize="11" Foreground="#FF747D84" /></Border>
            <TextBlock Text="注目の記事" FontSize="20" FontWeight="Bold" Foreground="#FF252A2F" Margin="0,18,0,10" />
            <ItemsControl ItemsSource="{Binding FeaturedNews}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="14" BorderBrush="#FFE0DBD4" BorderThickness="1" Margin="0,0,8,0" Padding="16" Style="{StaticResource NewsCard}" MouseLeftButtonDown="NewsCard_MouseLeftButtonDown"><StackPanel><Grid Height="110"><Border Background="#FFE8CFC3" CornerRadius="10" /><Image Source="{Binding ImageUrl}" Stretch="UniformToFill" Style="{StaticResource NewsImage}" /><TextBlock Text="🍜" FontSize="52" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ImagePlaceholder}" /></Grid><TextBlock Text="{Binding Category}" Foreground="#FFC56B4D" FontSize="11" FontWeight="Bold" Margin="0,12,0,4" /><TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" Foreground="#FF252A2F" TextWrapping="Wrap" /><TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#FF747D84" TextWrapping="Wrap" Margin="0,7,0,0" /><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PublishedAt, StringFormat=yyyy.MM.dd}" FontSize="11" Foreground="#FF9A938C" /><TextBlock Text="{Binding SourceName}" Grid.Column="2" FontSize="11" Foreground="#FF9A938C" /></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <DockPanel Margin="0,28,0,10"><TextBlock Text="新着ニュース" FontSize="20" FontWeight="Bold" Foreground="#FF252A2F" /><TextBlock DockPanel.Dock="Right" Text="指定日以前・最新順" Foreground="#FF9A938C" VerticalAlignment="Bottom" /></DockPanel>
            <ItemsControl ItemsSource="{Binding News}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="12" BorderBrush="#FFE0DBD4" BorderThickness="1" Padding="14" Margin="0,0,0,8" Style="{StaticResource NewsCard}" MouseLeftButtonDown="NewsCard_MouseLeftButtonDown"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid Grid.Column="0" Height="76"><Border Background="#FFF3E1DA" CornerRadius="8" /><Image Source="{Binding ImageUrl}" Stretch="UniformToFill" Style="{StaticResource NewsImage}" /><TextBlock Text="🍜" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ImagePlaceholder}" /></Grid><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="{Binding Category}" Foreground="#FFC56B4D" FontSize="11" FontWeight="Bold" /><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="#FF252A2F" TextWrapping="Wrap" Margin="0,3,0,0" /><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#FF747D84" TextWrapping="Wrap" Margin="0,4,0,0" /><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PublishedAt, StringFormat=yyyy.MM.dd HH:mm}" FontSize="10" Foreground="#FF9A938C" /><TextBlock Text="{Binding Region}" Grid.Column="2" FontSize="10" Foreground="#FF9A938C" /></Grid></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
