<UserControl x:Class="WpfGisLearning.Views.NewsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RefreshButton" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="FontSize" Value="18" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="4,0,0,0" /></Style>
        <Style x:Key="LoadingBar" TargetType="ProgressBar"><Setter Property="Height" Value="4" /><Setter Property="Visibility" Value="Collapsed" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="Background" Value="{StaticResource AccentPressedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="LoadingIndicator" TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NewsCard" TargetType="Border"><Setter Property="Cursor" Value="Hand" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter Property="Background" Value="#FFFFFCFA" /></Trigger></Style.Triggers></Style>
        <Style x:Key="ImagePlaceholder" TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasImage}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NewsImage" TargetType="Image"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasImage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource WindowBackgroundBrush}">
        <StackPanel Margin="0,0,14,0">
            <Grid Margin="0,14,0,18"><TextBlock Text="📰 ラーメンニュース" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}" /></Grid>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="日付" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" /><TextBlock Text="取得する日を選択" FontSize="10" Foreground="{StaticResource SubtleTextBrush}" Margin="0,2,0,0" /></StackPanel><DatePicker Grid.Column="1" SelectedDate="{Binding SelectedDate}" Margin="16,0,0,0" Padding="8,4" /><Button Grid.Column="3" Content="↻" ToolTip="ニュースを更新" Command="{Binding RefreshCommand}" Style="{StaticResource RefreshButton}" VerticalAlignment="Center" /></Grid></Border>
            <ProgressBar Style="{StaticResource LoadingBar}" IsIndeterminate="True" Margin="4,6,4,0" />
            <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12" Margin="0,8,0,0" Style="{StaticResource LoadingIndicator}"><StackPanel Orientation="Horizontal"><TextBlock Text="◌" FontSize="16" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" /><TextBlock Text="ニュースを読み込んでいます…" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" /></StackPanel></Border>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="4,8,0,0" />
            <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="10" Margin="0,8,0,0"><TextBlock Text="ニュース一覧をダブルクリックすると、元の記事をブラウザで開きます。画像がない記事はラーメンアイコンを表示します。" FontSize="11" Foreground="{StaticResource MutedBrush}" /></Border>
            <TextBlock Text="注目の記事" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,18,0,10" />
            <ItemsControl ItemsSource="{Binding FeaturedNews}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0" Padding="16" Style="{StaticResource NewsCard}" MouseLeftButtonDown="NewsCard_MouseLeftButtonDown"><StackPanel><Grid Height="110"><Border Background="{StaticResource ImagePlaceholderBrush}" CornerRadius="10" /><Image Source="{Binding ImageUrl}" Stretch="UniformToFill" Style="{StaticResource NewsImage}" /><TextBlock Text="🍜" FontSize="52" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ImagePlaceholder}" /></Grid><TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,12,0,4" /><TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" /><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PublishedAt, StringFormat=yyyy.MM.dd}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" /><TextBlock Text="{Binding SourceName}" Grid.Column="2" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" /></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <DockPanel Margin="0,28,0,10"><TextBlock Text="新着ニュース" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" /><TextBlock DockPanel.Dock="Right" Text="指定日以前・最新順" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Bottom" /></DockPanel>
            <ItemsControl ItemsSource="{Binding News}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,8" Style="{StaticResource NewsCard}" MouseLeftButtonDown="NewsCard_MouseLeftButtonDown"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid Grid.Column="0" Height="76"><Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" /><Image Source="{Binding ImageUrl}" Stretch="UniformToFill" Style="{StaticResource NewsImage}" /><TextBlock Text="🍜" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ImagePlaceholder}" /></Grid><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" /><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" /><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" /><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PublishedAt, StringFormat=yyyy.MM.dd HH:mm}" FontSize="10" Foreground="{StaticResource SubtleTextBrush}" /><TextBlock Text="{Binding Region}" Grid.Column="2" FontSize="10" Foreground="{StaticResource SubtleTextBrush}" /></Grid></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
