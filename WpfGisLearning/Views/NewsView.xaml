<UserControl x:Class="WpfGisLearning.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="Button"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#FF343A40" /><Setter Property="BorderBrush" Value="#FFE0DBD4" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="12,7" /><Setter Property="Margin" Value="3" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /></Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FFF4F1EC">
        <StackPanel Margin="28">
            <DockPanel><StackPanel><TextBlock Text="📰 ラーメンニュース" FontSize="28" FontWeight="Bold" Foreground="#FF252A2F" /><TextBlock Text="新店・限定メニュー・イベントなどの最新情報" Foreground="#FF747D84" Margin="0,4,0,0" /></StackPanel><Button DockPanel.Dock="Right" Content="← 店舗・地図へ戻る" Click="BackButton_Click" Padding="16,9" /></DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,22,0,0"><ItemsControl ItemsSource="{Binding Categories}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><RadioButton Content="{Binding}" GroupName="NewsCategory" IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ItemsControlItem}, Path=DataContext.SelectedCategory, Mode=TwoWay}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
            <TextBlock Text="注目の記事" FontSize="20" FontWeight="Bold" Foreground="#FF252A2F" Margin="0,18,0,10" />
            <ItemsControl ItemsSource="{Binding FeaturedNews}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="14" BorderBrush="#FFE0DBD4" BorderThickness="1" Margin="0,0,8,0" Padding="16"><StackPanel><Border Height="145" Background="#FFE8CFC3" CornerRadius="10"><TextBlock Text="🍜" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{Binding Category}" Foreground="#FFC56B4D" FontSize="11" FontWeight="Bold" Margin="0,12,0,4" /><TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" Foreground="#FF252A2F" TextWrapping="Wrap" /><TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#FF747D84" TextWrapping="Wrap" Margin="0,7,0,0" /><TextBlock Text="{Binding PublishedAt, StringFormat=yyyy.MM.dd}  /  {Binding Region}" FontSize="11" Foreground="#FF9A938C" Margin="0,10,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <DockPanel Margin="0,28,0,10"><TextBlock Text="新着ニュース" FontSize="20" FontWeight="Bold" Foreground="#FF252A2F" /><TextBlock DockPanel.Dock="Right" Text="最新順" Foreground="#FF9A938C" VerticalAlignment="Bottom" /></DockPanel>
            <ItemsControl ItemsSource="{Binding NewsView}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="12" BorderBrush="#FFE0DBD4" BorderThickness="1" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Height="76" Background="#FFF3E1DA" CornerRadius="8"><TextBlock Text="🍜" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="{Binding Category}" Foreground="#FFC56B4D" FontSize="11" FontWeight="Bold" /><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="#FF252A2F" TextWrapping="Wrap" Margin="0,3,0,0" /><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#FF747D84" TextWrapping="Wrap" Margin="0,4,0,0" /><TextBlock Text="{Binding PublishedAt, StringFormat=yyyy.MM.dd}  /  {Binding Region}" FontSize="10" Foreground="#FF9A938C" Margin="0,5,0,0" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
