<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
    x:Class="WpfGisLearning.Views.DetailView">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Background="#FFF7F5F2">

        <Grid
            MinWidth="520"
            MinHeight="650">

            <Border
                Margin="24"
                Padding="24"
                Background="White"
                BorderBrush="#FFE5E0DC"
                BorderThickness="1"
                CornerRadius="16">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition
                            Height="Auto" />

                        <RowDefinition
                            Height="Auto" />

                        <RowDefinition
                            Height="Auto" />

                        <RowDefinition
                            Height="Auto" />

                        <RowDefinition
                            Height="220" />

                        <RowDefinition
                            Height="Auto" />

                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel
                        Grid.Row="0">

                        <TextBlock
                            Text="🍜 店舗詳細"
                            FontSize="14"
                            Foreground="#FF8A7568"
                            Margin="0,0,0,8" />

                        <TextBlock
                            Text="店舗情報"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#FF2F2925" />

                    </StackPanel>

                    <!-- 店舗名 -->
                    <Border
                        Grid.Row="1"
                        Margin="0,24,0,0"
                        Padding="16"
                        Background="#FFFFF7F2"
                        CornerRadius="10">

                        <StackPanel>

                            <TextBlock
                                Text="店舗名"
                                FontSize="12"
                                Foreground="#FF8A7568" />

                            <TextBlock
                                Text="{Binding Shop.Name}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#FF2F2925"
                                Margin="0,4,0,0"
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </Border>

                    <!-- 住所・価格 -->
                    <Grid
                        Grid.Row="2"
                        Margin="0,12,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition
                                Width="2*" />

                            <ColumnDefinition
                                Width="*" />

                        </Grid.ColumnDefinitions>

                        <!-- 住所 -->
                        <Border
                            Grid.Column="0"
                            Padding="16"
                            Background="#FFF8F8F8"
                            CornerRadius="10"
                            Margin="0,0,6,0">

                            <StackPanel>

                                <TextBlock
                                    Text="住所"
                                    FontSize="12"
                                    Foreground="#FF8A7568" />

                                <TextBlock
                                    Text="{Binding Shop.Address}"
                                    FontSize="14"
                                    Foreground="#FF4A433E"
                                    Margin="0,4,0,0"
                                    TextWrapping="Wrap" />

                            </StackPanel>

                        </Border>

                        <!-- 価格 -->
                        <Border
                            Grid.Column="1"
                            Padding="16"
                            Background="#FFF8F8F8"
                            CornerRadius="10"
                            Margin="6,0,0,0">

                            <StackPanel>

                                <TextBlock
                                    Text="価格"
                                    FontSize="12"
                                    Foreground="#FF8A7568" />

                                <TextBlock
                                    Text="{Binding Shop.Price, StringFormat={}{0:N0}円}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="#FF4A433E"
                                    Margin="0,4,0,0" />

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- 店舗ID -->
                    <Border
                        Grid.Row="3"
                        Margin="0,12,0,0"
                        Padding="12"
                        Background="#FFF8F8F8"
                        CornerRadius="10">

                        <StackPanel>

                            <TextBlock
                                Text="店舗ID"
                                FontSize="12"
                                Foreground="#FF8A7568" />

                            <TextBlock
                                Text="{Binding Id}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#FF2F2925"
                                Margin="0,4,0,0" />

                        </StackPanel>

                    </Border>

                    <!-- 地図 -->
                    <Border
                        Grid.Row="4"
                        Margin="0,12,0,0"
                        CornerRadius="10"
                        ClipToBounds="True"
                        BorderBrush="#FFE5E0DC"
                        BorderThickness="1">

                        <mapsui:MapControl
                            x:Name="DetailMap" />

                    </Border>

                    <!-- Buttons -->
                    <StackPanel
                        Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">

                        <Button
                            Content="削除"
                            Padding="20,10"
                            Background="#FFB4552B"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="DeleteButton_Click" />

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>