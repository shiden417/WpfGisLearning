<UserControl x:Class="WpfGisLearning.Views.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
             xmlns:conv="clr-namespace:WpfGisLearning.Converters">
    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource WindowBackgroundBrush}"><Grid MinWidth="680" Margin="24"><Border Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="28" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="320" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid Grid.Row="0"><StackPanel Margin="0,0,70,0"><TextBlock Text="店舗詳細" FontSize="13" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" /><TextBlock Text="{Binding Shop.Name}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="26" Command="{Binding ToggleFavoriteCommand}" ToolTip="お気に入り"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Content" Value="☆" /><Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Content" Value="★" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid><Border Grid.Row="1" Margin="0,20,0,0" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="12"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding PhotoPaths.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding PhotoPaths}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="150" Height="110" Margin="0,0,10,0" CornerRadius="8" ClipToBounds="True" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PanelBrush}"><Image Stretch="UniformToFill" Source="{Binding Converter={StaticResource ImagePathConverter}}" MouseLeftButtonUp="Photo_Click" Tag="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border><Grid Grid.Row="2" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14" Margin="0,0,5,0"><StackPanel><TextBlock Text="ジャンル" FontSize="12" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Shop.RamenType}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0" /></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14" Margin="5,0"><StackPanel><TextBlock Text="価格" FontSize="12" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Shop.Price, StringFormat={}{0:N0}円}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0" /></StackPanel></Border><Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14" Margin="5,0,0,0"><StackPanel><TextBlock Text="評価" FontSize="12" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Shop.Rating, StringFormat=★ {0:F1}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource RatingBrush}" Margin="0,5,0,0" /></StackPanel></Border></Grid><Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,0,5,0"><StackPanel><TextBlock Text="営業時間・定休日" FontSize="11" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Shop.OpeningHours, TargetNullValue=未登録}" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" /><TextBlock Text="{Binding Shop.ClosedDay, TargetNullValue=未登録}" FontSize="12" Foreground="{StaticResource LabelBrush}" Margin="0,3,0,0" /></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14" Margin="5,0,0,0"><StackPanel><TextBlock Text="住所" FontSize="11" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Shop.Address, TargetNullValue=住所未登録}" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border></Grid><Border Grid.Row="4" Margin="0,12,0,0" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True"><Grid><mapsui:MapControl x:Name="DetailMap" /><Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Background="#F8FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4" Panel.ZIndex="100"><StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="＋" Style="{StaticResource MapControlButton}" Click="ZoomInButton_Click" ToolTip="拡大" /><Button Content="−" Style="{StaticResource MapControlButton}" Click="ZoomOutButton_Click" ToolTip="縮小" /></StackPanel></StackPanel></Border></Grid></Border><Grid Grid.Row="5" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Grid.Column="0" Content="🗑" Style="{StaticResource DangerActionButton}" HorizontalAlignment="Left" Click="DeleteButton_Click" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="×" Style="{StaticResource ActionButton}" ToolTip="閉じる" Click="CloseButton_Click" /><Button Content="✎" Style="{StaticResource AccentActionButton}" Click="EditButton_Click" /></StackPanel></Grid></Grid></Border></Grid></ScrollViewer>
</UserControl>
