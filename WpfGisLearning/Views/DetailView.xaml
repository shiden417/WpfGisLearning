<UserControl x:Class="WpfGisLearning.Views.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mapsui="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FFF5F3EE">
        <Grid MinWidth="560" Margin="24">
            <Border Background="White" CornerRadius="18" Padding="24" BorderBrush="#FFDCE0DA" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="260" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel Margin="0,0,60,0"><TextBlock Text="店舗詳細" FontSize="14" Foreground="#FF596B58" FontWeight="Bold" /><TextBlock Text="{Binding Shop.Name}" FontSize="28" FontWeight="Bold" Foreground="#FF303630" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="28" Padding="8,2" Background="Transparent" BorderThickness="0" Foreground="#FF596B58" Command="{Binding ToggleFavoriteCommand}"><Button.Style><Style TargetType="Button"><Setter Property="Content" Value="☆" /><Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Content" Value="★" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FFF1F5EF" CornerRadius="12" Padding="14" Margin="0,0,5,0"><StackPanel><TextBlock Text="種類" FontSize="12" Foreground="#FF778078" /><TextBlock Text="{Binding Shop.RamenType}" FontSize="16" FontWeight="Bold" Foreground="#FF596B58" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Grid.Column="1" Background="#FFF1F5EF" CornerRadius="12" Padding="14" Margin="5,0"><StackPanel><TextBlock Text="価格" FontSize="12" Foreground="#FF778078" /><TextBlock Text="{Binding Shop.Price, StringFormat={}{0:N0}円}" FontSize="18" FontWeight="Bold" Foreground="#FF596B58" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Grid.Column="2" Background="#FFF1F5EF" CornerRadius="12" Padding="14" Margin="5,0,0,0"><StackPanel><TextBlock Text="評価" FontSize="12" Foreground="#FF778078" /><TextBlock Text="{Binding Shop.Rating, StringFormat=★ {0:F1}}" FontSize="18" FontWeight="Bold" Foreground="#FF596B58" Margin="0,5,0,0" /></StackPanel></Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FFF5F6F3" CornerRadius="10" Padding="14" Margin="0,0,5,0"><StackPanel><TextBlock Text="おすすめメニュー" FontSize="11" Foreground="#FF778078" /><TextBlock Text="{Binding Shop.RecommendedMenu, TargetNullValue=未登録}" FontSize="14" Foreground="#FF454B46" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                        <Border Grid.Column="1" Background="#FFF5F6F3" CornerRadius="10" Padding="14" Margin="5,0,0,0"><StackPanel><TextBlock Text="営業時間・定休日" FontSize="11" Foreground="#FF778078" /><TextBlock Text="{Binding Shop.OpeningHours, TargetNullValue=未登録}" FontSize="13" Foreground="#FF454B46" Margin="0,4,0,0" /><TextBlock Text="{Binding Shop.ClosedDay, TargetNullValue=未登録}" FontSize="12" Foreground="#FF657064" Margin="0,3,0,0" /></StackPanel></Border>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FFF5F6F3" CornerRadius="10" Padding="14" Margin="0,0,5,0"><StackPanel><TextBlock Text="住所" FontSize="11" Foreground="#FF778078" /><TextBlock Text="{Binding Shop.Address, TargetNullValue=住所未登録}" FontSize="14" Foreground="#FF454B46" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                        <Border Grid.Column="1" Background="#FFF5F6F3" CornerRadius="10" Padding="14" Margin="5,0,0,0"><StackPanel><TextBlock Text="タグ" FontSize="11" Foreground="#FF778078" /><TextBlock Text="{Binding Shop.Tags, TargetNullValue=タグ未登録}" FontSize="14" Foreground="#FF454B46" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                    </Grid>
                    <Border Grid.Row="4" Margin="0,12,0,0" CornerRadius="12" BorderBrush="#FFDCE0DA" BorderThickness="1" ClipToBounds="True"><mapsui:MapControl x:Name="DetailMap" /></Border>
                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="削除" Padding="18,9" Background="#FF6E746D" Foreground="White" BorderThickness="0" Click="DeleteButton_Click" />
                        <Button Content="閉じる" Padding="18,9" Click="CloseButton_Click" />
                        <Button Content="編集" Padding="20,9" Background="#FF596B58" Foreground="White" BorderThickness="0" Click="EditButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
