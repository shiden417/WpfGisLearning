<UserControl x:Class="WpfGisLearning.Views.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
             xmlns:conv="clr-namespace:WpfGisLearning.Converters">
    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFC56B4D" /><SolidColorBrush x:Key="TextBrush" Color="#FF252A2F" /><SolidColorBrush x:Key="MutedBrush" Color="#FF747D84" /><SolidColorBrush x:Key="PanelBrush" Color="#FFF8F5F1" /><SolidColorBrush x:Key="BorderBrush" Color="#FFE0DBD4" />
        <Style x:Key="IconButton" TargetType="Button"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="#FFB58A3C" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Padding" Value="6" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FFF3E1DA" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        <Style x:Key="ActionIconButton" TargetType="Button"><Setter Property="Width" Value="38" /><Setter Property="Height" Value="38" /><Setter Property="FontSize" Value="18" /><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#FF343A40" /><Setter Property="BorderBrush" Value="#FFE0DBD4" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Margin" Value="6,0,0,0" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FFF3E1DA" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFC56B4D" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FFE8CFC3" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        <Style x:Key="DeleteIconButton" TargetType="Button" BasedOn="{StaticResource ActionIconButton}"><Setter Property="Foreground" Value="#FFB44B4B" /><Setter Property="BorderBrush" Value="#FFE8CACA" /><Setter Property="ToolTip" Value="店舗を削除" /></Style>
        <Style x:Key="SecondaryAction" TargetType="Button" BasedOn="{StaticResource ActionIconButton}"><Setter Property="ToolTip" Value="閉じる" /></Style>
        <Style x:Key="AccentAction" TargetType="Button" BasedOn="{StaticResource ActionIconButton}"><Setter Property="Background" Value="#FFC56B4D" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#FFC56B4D" /><Setter Property="ToolTip" Value="店舗を編集" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FFB85A40" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFB85A40" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FF9F4B35" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FFF4F1EC"><Grid MinWidth="680" Margin="24"><Border Background="White" CornerRadius="18" Padding="28" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="320" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid Grid.Row="0"><StackPanel Margin="0,0,70,0"><TextBlock Text="店舗詳細" FontSize="13" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" /><TextBlock Text="{Binding Shop.Name}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="26" Command="{Binding ToggleFavoriteCommand}" ToolTip="お気に入り"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Content" Value="☆" /><Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Content" Value="★" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid><Border Grid.Row="1" Margin="0,20,0,0" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="12"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding PhotoPaths.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding PhotoPaths}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="150" Height="110" Margin="0,0,10,0" CornerRadius="8" ClipToBounds="True" BorderBrush="#FFE0DBD4" BorderThickness="1" Background="#FFEDE8E2"><Image Stretch="UniformToFill" Source="{Binding Converter={StaticResource ImagePathConverter}}" MouseLeftButtonUp="Photo_Click" Tag="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border><Grid Grid.Row="2" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14" Margin="0,0,5,0"><StackPanel><TextBlock Text="ジャンル" FontSize="12" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Shop.RamenType}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0" /></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14" Margin="5,0"><StackPanel><TextBlock Text="価格" FontSize="12" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Shop.Price, StringFormat={}{0:N0}円}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0" /></StackPanel></Border><Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14" Margin="5,0,0,0"><StackPanel><TextBlock Text="評価" FontSize="12" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Shop.Rating, StringFormat=★ {0:F1}}" FontSize="18" FontWeight="Bold" Foreground="#FFB58A3C" Margin="0,5,0,0" /></StackPanel></Border></Grid><Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,0,5,0"><StackPanel><TextBlock Text="営業時間・定休日" FontSize="11" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Shop.OpeningHours, TargetNullValue=未登録}" FontSize="13" Foreground="#FF454B46" Margin="0,4,0,0" /><TextBlock Text="{Binding Shop.ClosedDay, TargetNullValue=未登録}" FontSize="12" Foreground="#FF657064" Margin="0,3,0,0" /></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14" Margin="5,0,0,0"><StackPanel><TextBlock Text="住所" FontSize="11" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Shop.Address, TargetNullValue=住所未登録}" FontSize="14" Foreground="#FF454B46" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></Border></Grid><Border Grid.Row="4" Margin="0,12,0,0" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True"><mapsui:MapControl x:Name="DetailMap" /></Border><Grid Grid.Row="5" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Grid.Column="0" Content="🗑" Style="{StaticResource DeleteIconButton}" HorizontalAlignment="Left" Click="DeleteButton_Click" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="×" Style="{StaticResource SecondaryAction}" Click="CloseButton_Click" /><Button Content="✎" Style="{StaticResource AccentAction}" Click="EditButton_Click" /></StackPanel></Grid></Grid></Border></Grid></ScrollViewer>
</UserControl>
