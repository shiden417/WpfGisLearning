<UserControl x:Class="WpfGisLearning.Views.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FFF9F4EF">
        <Grid MinWidth="520" Margin="24">
            <Border Background="White" CornerRadius="18" Padding="24" BorderBrush="#FFE9DED8" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="260" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="🍜 店舗詳細" FontSize="14" Foreground="#FFB83D2E" FontWeight="Bold" />
                        <TextBlock Text="{Binding Shop.Name}" FontSize="28" FontWeight="Bold" Foreground="#FF332925" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FFFFF5EE" CornerRadius="12" Padding="16" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="住所" FontSize="12" Foreground="#FF8A7568" />
                                <TextBlock Text="{Binding Shop.Address, TargetNullValue=住所未登録}" FontSize="14" Foreground="#FF4A433E" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#FFFFF5EE" CornerRadius="12" Padding="16" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="価格" FontSize="12" Foreground="#FF8A7568" />
                                <TextBlock Text="{Binding Shop.Price, StringFormat={}{0:N0}円}" FontSize="20" FontWeight="Bold" Foreground="#FFB83D2E" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Margin="0,12,0,0" CornerRadius="12" BorderBrush="#FFE9DED8" BorderThickness="1" ClipToBounds="True">
                        <mapsui:MapControl x:Name="DetailMap" />
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="閉じる" Padding="18,9" Click="CloseButton_Click" />
                        <Button Content="編集" Padding="20,9" Background="#FFF28C28" Foreground="White" BorderThickness="0" Click="EditButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
