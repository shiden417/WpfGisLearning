<UserControl x:Class="WpfGisLearning.Views.ShopEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#FF2B3035" /><Setter Property="BorderBrush" Value="#FFE0DBD4" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="10,7" /><Setter Property="Margin" Value="3" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FFF3E1DA" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFC56B4D" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FFE8CFC3" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style TargetType="ComboBox"><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    </UserControl.Resources>
    <Grid Background="#FFF4F1EC">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FF20252A" Padding="24,18"><StackPanel><TextBlock Text="🍜 Ramenia" Foreground="White" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding ScreenTitle}" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" /></StackPanel></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border Background="White" CornerRadius="16" Padding="22" BorderBrush="#FFE0DBD4" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="店舗情報" FontSize="18" FontWeight="Bold" Foreground="#FF252A2F" />
                            <TextBlock Text="店舗名" Margin="0,18,0,5" Foreground="#FF68727B" /><TextBox Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="14" /><TextBlock Text="{Binding ShopNameError}" Foreground="#FFB44B4B" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="価格" Margin="0,12,0,5" Foreground="#FF68727B" /><TextBox Text="{Binding ShopPrice, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="14" /><TextBlock Text="{Binding ShopPriceError}" Foreground="#FFB44B4B" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="ラーメンの種類" Margin="0,12,0,5" Foreground="#FF68727B" /><ComboBox ItemsSource="{Binding RamenTypes}" SelectedItem="{Binding RamenType}" Height="36" Padding="8,0" />
                            <TextBlock Text="営業時間" Margin="0,12,0,5" Foreground="#FF68727B" /><TextBox Text="{Binding OpeningHours, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="14" />
                            <TextBlock Text="定休日" Margin="0,12,0,5" Foreground="#FF68727B" /><TextBox Text="{Binding ClosedDay, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="14" />
                            <TextBlock Text="評価" Margin="0,12,0,5" Foreground="#FF68727B" /><TextBox Text="{Binding Rating, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="14" />
                            <TextBlock Text="住所" Margin="0,12,0,5" Foreground="#FF68727B" /><TextBox Text="{Binding ShopAddress, UpdateSourceTrigger=PropertyChanged}" Height="60" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8" />
                            <TextBlock Text="位置" Margin="0,16,0,5" Foreground="#FF68727B" /><Border Background="#FFF8F5F1" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="{Binding ShopLatitude, StringFormat=緯度: {0:F6}}" Foreground="#FF343A40" /><TextBlock Text="{Binding ShopLongitude, StringFormat=経度: {0:F6}}" Foreground="#FF343A40" Margin="0,4,0,0" /><TextBlock Text="新規登録: 地図をダブルクリック / 編集: マーカーをドラッグ" FontSize="11" Foreground="#FF7B858C" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel></Border><TextBlock Text="{Binding LocationError}" Foreground="#FFB44B4B" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" /><TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB44B4B" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="16" Padding="18" Margin="0,16,0,0" BorderBrush="#FFE0DBD4" BorderThickness="1">
                        <StackPanel>
                            <DockPanel><TextBlock Text="店舗写真" FontSize="18" FontWeight="Bold" Foreground="#FF252A2F" /><Button DockPanel.Dock="Right" Content="＋ 写真を追加" Click="AddPhotoButton_Click" Background="#FFC56B4D" Foreground="White" BorderThickness="0" /></DockPanel>
                            <TextBlock Text="複数選択できます。★をメイン写真に設定できます。" FontSize="11" Foreground="#FF7B858C" Margin="0,5,0,12" />
                            <ItemsControl ItemsSource="{Binding Photos}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Width="150" Height="150" Margin="0,0,10,10" CornerRadius="10" BorderBrush="#FFE0DBD4" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <Image Stretch="UniformToFill"><Image.Source><Binding SourcePath /></Image.Source></Image>
                                            <Border Background="#AA20252A" VerticalAlignment="Bottom" Padding="4"><StackPanel Orientation="Horizontal"><Button Content="★" Width="32" Height="28" Padding="0" Click="SetMainPhotoButton_Click" Tag="{Binding}" /><Button Content="削除" Height="28" Padding="7,0" Click="RemovePhotoButton_Click" Tag="{Binding}" /></StackPanel></Border>
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#DDC56B4D" CornerRadius="7" Padding="5,2" Margin="5" Visibility="{Binding IsMain, Converter={x:Static BooleanToVisibilityConverter.Instance}}"><TextBlock Text="MAIN" Foreground="White" FontSize="9" FontWeight="Bold" /></Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="写真なしでも登録できます。" FontSize="11" Foreground="#FF9A938C" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="10" BorderBrush="#FFE0DBD4" BorderThickness="1"><Grid><mapsui:MapControl x:Name="EditMapControl" /><StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14"><Button Content="◎  現在地" Click="CurrentLocationButton_Click" Padding="12,8" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"><Button Content="＋" Click="ZoomInButton_Click" Width="40" Height="38" FontSize="18" FontWeight="Bold" ToolTip="拡大" /><Button Content="−" Click="ZoomOutButton_Click" Width="40" Height="38" FontSize="18" FontSize="18" FontWeight="Bold" ToolTip="縮小" /></StackPanel></StackPanel></Grid></Border>
            </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#FFE0DBD4" BorderThickness="0,1,0,0" Padding="18"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="キャンセル" Command="{Binding CancelCommand}" Padding="18,9" Margin="0,0,8,0" /><Button Content="保存" Command="{Binding SaveCommand}" Padding="22,9" Background="#FFC56B4D" Foreground="White" BorderThickness="0" FontWeight="SemiBold" /></StackPanel></Border>
    </Grid>
</UserControl>
